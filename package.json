{
  "name": "embedded-calendar-schedule",
  "version": "1.0.0",
  "description": "Obsidian 插件：嵌入交互式日历日程，支持右键添加日程、节假日标记与 TaskNotes 联动",
  "main": "main.js",
  "scripts": {
    "dev": "node esbuild.mjs",
    "build": "tsc --noEmit && node esbuild.mjs production",
    "deploy": "node esbuild.mjs production && node deploy.mjs",
    "test": "node tests/run-all.mjs"
  },
  "keywords": [
    "obsidian",
    "calendar",
    "schedule"
  ],
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^24.0.0",
    "esbuild": "^0.28.2",
    "jsdom": "^30.1.1",
    "obsidian": "^1.13.1",
    "typescript": "^5.9.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
